stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole
loglevel=7

blkmapcmd=blkmap create root;
	  blkmap map root 0 ${blkmap_size_r} linear ${blkmap_blk_ifname} ${blkmap_blk_dev} ${blkmap_blk_nr}

preboot=run blkmapcmd

bootdelay=0
bootcmd=bootefi bootmgr; pause; bootmenu

fastbootcmd=echo "Fastboot Mode";
	fastboot -l $fastboot_addr_r usb 0

bootmenu_0=Continue Boot=boot
bootmenu_1=Enter Fastboot Mode=run fastbootcmd
bootmenu_2=UEFI Maintenance Menu=eficonfig
bootmenu_3=Reboot=reset
bootmenu_4=Power Off=poweroff
bootmenu_5=Run Self-Test=run selftest; pause
bootmenu_6=Backup eMMC Boot Area (SD)=run dump_bootarea; pause

button_cmd_0_name=Volume Down Key
button_cmd_0=bootmenu

selftest_pass=0
selftest_fail=0
st_ok=setexpr selftest_pass ${selftest_pass} + 1
st_bad=setexpr selftest_fail ${selftest_fail} + 1

st_ram=echo "--- RAM";
	bdinfo;
	mw.l 0x90000000 0xdeadbeef 0x40000;
	mw.l 0x91000000 0x12345678 0x40000;
	if cmp.l 0x90000000 0x91000000 0x40000; then echo "TEST ram distinct FAIL"; run st_bad;
	else cp.l 0x90000000 0x91000000 0x40000;
	  if cmp.l 0x90000000 0x91000000 0x40000; then echo "TEST ram copy/compare PASS"; run st_ok; else echo "TEST ram copy/compare FAIL"; run st_bad; fi;
	fi

st_mmc=echo "--- mmc ${st_dev}";
	if mmc dev ${st_dev}; then
	  mmc info;
	  if mmc read 0x92000000 0 0x800; then echo "TEST mmc${st_dev} read PASS"; run st_ok; else echo "TEST mmc${st_dev} read FAIL"; run st_bad; fi;
	  part list mmc ${st_dev};
	else echo "TEST mmc${st_dev} FAIL (no device)"; run st_bad; fi

selftest=echo "===== A145F U-Boot self-test =====";
	version;
	setenv selftest_pass 0; setenv selftest_fail 0;
	run st_ram;
	setenv st_dev 0; run st_mmc;
	mmc rescan; setenv st_dev 1; run st_mmc;
	echo "SUMMARY pass=${selftest_pass} fail=${selftest_fail}";
	echo "(USB/fastboot: pick Enter Fastboot Mode and run: fastboot devices)"

# --- eMMC boot-area backup, for recovery if a custom bootloader bricks ---
# the device. This reads the boot0/boot1 hardware partitions (where
# BL1/BL2/SBOOT live on these devices) and saves them to the SD card as
# raw files. It does NOT touch the SoC BootROM: that is masked into the
# silicon, not readable by software, and not needed for recovery -- the
# BootROM's own USB download mode is the actual hard-brick fallback and
# runs independently of eMMC contents. Verify download mode (hold both
# volume keys while plugging in USB) still responds BEFORE relying on it.
#
# BOOT_SIZE defaults to 4 MiB (0x2000 sectors); check the real size with
# 'mmc dev 0 1; mmc info' (look at "boot size") and override if different:
#   setenv boot_size_sectors 0x4000; run dump_bootarea
boot_size_sectors=0x2000

dump_one_bootpart=echo "--- dumping eMMC boot${hwpart} (${boot_size_sectors} sectors) ---";
	setexpr boot_size_bytes ${boot_size_sectors} \* 0x200;
	if mmc dev 0 ${hwpart}; then
	  mmc read 0x92000000 0 ${boot_size_sectors};
	  if save mmc 1:1 0x92000000 boot${hwpart}.bin ${boot_size_bytes}; then
	    echo "saved boot${hwpart}.bin to SD card";
	  else echo "FAILED to save boot${hwpart}.bin (no SD / no filesystem?)"; fi;
	else echo "FAILED to select eMMC hw partition ${hwpart}"; fi

dump_bootarea=echo "===== eMMC boot-area backup =====";
	mmc dev 0;
	setenv hwpart 1; run dump_one_bootpart;
	setenv hwpart 2; run dump_one_bootpart;
	mmc dev 0;
	echo "done. Copy boot1.bin and boot2.bin off the SD card and keep them -";
	echo "that is your restore image if a custom bootloader bricks the device."
